# Railway MySQL plugin injects this automatically when the DB is attached
DATABASE_URL=mysql://user:password@host:3306/railway

# Cloudflare R2 (product images, label PDFs, COA PDFs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=astraea-vitamins
R2_PUBLIC_URL=

# Resend (transactional email — waitlist, order confirmations)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@astraeavitamins.com

PORT=3000

# Auth (JWT in an httpOnly cookie — customer accounts + admin panel)
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional — used to build the URL encoded in each product's QR code
# (e.g. https://astraeavitamins.com/lab-tests?product=<handle>).
# If unset, the server uses the incoming request's own host, which works
# fine on Railway too — only set this if you need the QR to point somewhere
# different from the domain the app is actually running on.
SITE_URL=
